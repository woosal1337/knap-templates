{
  "name": "knap-templates",
  "version": "0.1.0",
  "description": "Render Knap templates into Markdown inside Obsidian.",
  "type": "module",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run verify:release && npm run verify:bundle",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "knap",
    "markdown",
    "templates"
  ],
  "author": {
    "name": "Ege",
    "url": "https://github.com/woosal1337"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woosal1337/knap-templates.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "knap": "0.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^5.0.0"
  }
}
